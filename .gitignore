# Root directories and files to exclude
# The root package.json is a script runner, not a workspace: a root lockfile
# would change Next.js's project-root detection for apps/*. Install per app.
/package-lock.json
/.zyndai-agent/
/supabase/
/out.txt
/.claude/

# Common language/environment files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.env
.env.*
!.env.example
!.env.*.example
node_modules/
.DS_Store
Thumbs.db
*.log

# Backend specific
/services/persona-api/.env
/services/persona-api/.agent-zynd-networking/

# Webapp specific
/apps/persona-web/.next/
/apps/persona-web/.vercel/
/apps/persona-web/out/
/apps/persona-web/build/
/apps/persona-web/coverage/
/apps/persona-web/*.tsbuildinfo
/apps/persona-web/.pnp
/apps/persona-web/.pnp.*
/apps/persona-web/.yarn/*
!/apps/persona-web/.yarn/patches
!/apps/persona-web/.yarn/plugins
!/apps/persona-web/.yarn/releases
!/apps/persona-web/.yarn/versions
/apps/persona-web/npm-debug.log*
/apps/persona-web/yarn-debug.log*
/apps/persona-web/yarn-error.log*
/apps/persona-web/.pnpm-debug.log*

.agent-*

SCREENS.md 
UX_BRIEF.md 
prototype.html 
