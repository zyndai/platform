# Copy to .env and fill in. .env is gitignored.

# --- Infra (match docker-compose.yml host ports) ---
DATABASE_URL=postgresql://zynd:zynd@localhost:5433/zynd
REDIS_URL=redis://localhost:6380

# --- Embeddings: OpenAI text-embedding-3-small (1536 dims) ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# --- Extraction: DeepSeek V3 (OpenAI-compatible endpoint) ---
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
EXTRACTION_MODEL=deepseek-chat

# --- Dev auth: shared bearer mapped to DEV_USER_EMAIL (local testing only) ---
DEV_BEARER_TOKEN=dev-secret
DEV_USER_EMAIL=dev@zynd.local

# --- M2 auth: JWT + OAuth for the ChatGPT Action ---
# Production MUST set a strong random value: openssl rand -hex 32
JWT_SECRET=
OAUTH_CLIENT_ID=zynd-chatgpt
OAUTH_CLIENT_SECRET=zynd-oauth-secret
# Public HTTPS URL of this API once deployed (used in the Action schema + OAuth URLs).
PUBLIC_BASE_URL=http://localhost:8001
# Public base URL of the MCP server (where MCP clients connect). May differ from
# PUBLIC_BASE_URL if the MCP server runs on a different host/port (e.g. port 8090).
MCP_PUBLIC_BASE_URL=http://localhost:8090
# OAuth access expires in one hour. Each single-use refresh replacement starts
# a new 30-day expiry; clients store/rotate credentials, not onboarding pages.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
# Keep dev/prod issuer and MCP resource URLs distinct when Redis is shared.

# --- OAuth provider credentials (for MCP tools: Twitter, LinkedIn, Google, Notion) ---
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Exa / Tavily / Firecrawl (LinkedIn people search + profile enrichment) ---
# Exa: semantic neural search — primary LinkedIn profile finder
# Get a key at https://exa.ai
EXA_API_KEY=
# Tavily: keyword search — fallback if Exa is unavailable
# Get a key at https://tavily.com
TAVILY_API_KEY=
# Firecrawl: web scraping — enriches LinkedIn profiles with name/headline/about
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# QuickEnrich contact-finder used by find_people. Empty disables that source.
# Same keys as cards-api / persona-api. Auth header is Authorization (Bearer)
# on cards, X-API-Key on persona — match the deployment that issued the key.
QUICKENRICH_BASE_URL=
QUICKENRICH_API_KEY=
QUICKENRICH_AUTH_HEADER=Authorization
QUICKENRICH_TIMEOUT=12

# --- Zynd Network ---
ZYND_REGISTRY_URL=https://zns01.zynd.ai
ZYND_DEPLOYER_URL=https://deployer.zynd.ai
ZYND_DEVELOPER_KEYPAIR_PATH=
PUBLIC_PAGE_BASE_URL=

# --- S11 public Cards MCP (no auth) at /cards-public-mcp ---
# Off by default. Set true on the mcp container (.env.prod on the box).
# Pair with cards-web NEXT_PUBLIC_FEATURE_S11_PUBLIC_MCP=true to advertise
# on /for-ai, llms.txt, agents.txt. Compose prod already sets
# CARDS_API_BASE_URL=http://cards:8000 when the mcp service starts.
FEATURE_S11_PUBLIC_MCP=false
CARDS_API_BASE_URL=http://localhost:8002
CARDS_SITE_BASE_URL=https://cards.zynd.ai
S11_RATE_LIMIT_PER_MINUTE=60
S11_GET_CARD_CACHE_TTL_SECONDS=60
S11_MAX_RESPONSE_BYTES=256000

# --- Supabase (for token store + persona data) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# S12 UUID-only bridge: the shared aafo issuer, e.g. <SUPABASE_URL>/auth/v1.
# Empty disables the identity bridge; do not infer this from an email match.
S12_IDENTITY_ISSUER=
FEATURE_S12_INTROS=false
FEATURE_S12_MCP_ACTIONS=false
# Supabase projects whose login tokens memory accepts: "url|anon_key" pairs,
# comma-separated. Empty = just SUPABASE_URL + SUPABASE_ANON_KEY.
TRUSTED_SUPABASE_PROJECTS=

# Dedicated ChatGPT/Codex plugin: existing /mcp, private memory + card scopes.
# Empty exact HTTPS callbacks disable the client. Copy actual runtime/review
# callbacks from the OpenAI portal after human approval; no prefix wildcards.
PLUGIN_OAUTH_CLIENT_ID=zynd-chatgpt-plugin
PLUGIN_OAUTH_REDIRECT_URIS=
