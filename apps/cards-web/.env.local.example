# Zynd Cards (cards.zynd.ai) — local dev env
#
# STATUS: this app is not live-functional yet. Auth needs the aafo (persona)
# Supabase project to have the vector extension, an `avatars` storage bucket,
# and Google/LinkedIn/email auth enabled — see ZYND_CARDS_MOVE_PLAN.md §4
# (H2-H4). Card reads work today against the unchanged cards API.

# The persona ("aafo") Supabase project — NOT the dashboard's xmfj project.
# Get these from Supabase dashboard → aafo project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the client. Used for
# avatar uploads to the `avatars` bucket once it exists (H3).
SUPABASE_SERVICE_ROLE_KEY=

# Cards API — unchanged, still serving from xmfj until the cards-move P4
# cutover switches it to aafo.
# Local cards-api: http://localhost:8002 (npm run dev:cards-api at the repo root)
NEXT_PUBLIC_API_URL=https://api.zynd.ai
# Memory API, used by lib/memory.ts (ProfileChatWidget calls the cards API's
# own /chat/profile proxy, not this directly) and by lib/mcp-connector.ts
# (POST /token/exchange + POST /me/logout).
NEXT_PUBLIC_ZYND_API_URL=https://api.zynd.ai
# Centralized/shared MCP server URL shown in the "Add MCP" config. When empty,
# the connect flow falls back to the URL the memory layer advertises.
NEXT_PUBLIC_MCP_URL=

NEXT_PUBLIC_SITE_URL=https://cards.zynd.ai
NEXT_PUBLIC_FEATURE_S12_INTROS=false

# S06: page / data.json / JSON-LD / llms read CardView (/view) with fact
# provenance + expiry. Pair with cards-api FEATURE_S06_CARDVIEW=true.
NEXT_PUBLIC_FEATURE_S06_CARDVIEW=false

# S08: onboarding v2 (live preview, no 6-step quiz). Cookie zynd_s08=0|1
# forces v1/v2; unset visitors are sticky-bucketed by PCT (0–100).
NEXT_PUBLIC_FEATURE_S08_ONBOARDING_V2=false
NEXT_PUBLIC_FEATURE_S08_PCT=0

# S04 client events (create funnel / first-win). Pair with cards-api FEATURE_S04_EVENTS.
NEXT_PUBLIC_S04_EVENTS=false

# S11: advertise public Cards MCP on /for-ai, llms.txt, agents.txt.
# Off by default (unlisted). Set true only after memory FEATURE_S11_PUBLIC_MCP
# is on — NEXT_PUBLIC_* is baked at `npm run build`, so rebuild + pm2 restart
# cards-web after flipping. Endpoint: https://api.zynd.ai/cards-public-mcp
NEXT_PUBLIC_FEATURE_S11_PUBLIC_MCP=false

# Optional — Google Analytics measurement id.
NEXT_PUBLIC_ANALYTICS_ID=

#required for avatar refresh. generate any
AVATAR_REFRESH_TOKEN=
