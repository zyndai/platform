{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zynd": {
      "type": "streamable-http",
      "url": "https://api.zynd.ai/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "zynd-chatgpt-plugin",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://api.zynd.ai/chatgpt/mcp",
            "baseScopes": ["memory:recall", "memory:propose", "cards:review"]
          }
        }
      }
    }
  }
}
