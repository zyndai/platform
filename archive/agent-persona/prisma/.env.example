# Prisma database URLs. Place this in `webapp/.env` (or load via direnv)
# so the Prisma CLI picks them up when running migrations.
#
# DATABASE_URL  — pooled connection used at runtime (if/when we wire
#                 Prisma Client). Supabase exposes this as the Pooler
#                 connection string from Project Settings → Database.
#
# DIRECT_URL    — direct, non-pooled connection used by `prisma migrate`
#                 and the `prisma:policies` script. Migrations need a
#                 direct connection because PgBouncer in transaction
#                 mode doesn't carry prepared statements across
#                 statements in a way `migrate` expects.
#
# Both come from the same Supabase project. The DB password is set in
# Project Settings → Database → Connection string.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
