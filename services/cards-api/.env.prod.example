OPENAI_API_KEY=your_openai_key

# ── Scraping ──
GITHUB_TOKEN=your_github_pat
APIFY_API_KEY=your_apify_token

# ── Site / indexing ──
SITE_BASE_URL=https://www.zynd.ai
