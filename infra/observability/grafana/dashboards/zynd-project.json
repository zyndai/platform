{
  "uid": "zynd-project",
  "title": "Project",
  "description": "One service in one environment: health, memory, traffic, latency and its logs. Pick env and project at the top.",
  "tags": [
    "zynd"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "prod,dev",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "definition": "label_values({__name__=~\"container_memory_working_set_bytes|pm2_process_memory_bytes\",env=\"$env\",project!~\"monitoring|box\"}, project)",
        "query": {
          "query": "label_values({__name__=~\"container_memory_working_set_bytes|pm2_process_memory_bytes\",env=\"$env\",project!~\"monitoring|box\"}, project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "memory-api",
          "value": "memory-api"
        }
      },
      {
        "name": "search",
        "label": "Log filter",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Zynd dashboards",
      "tags": [
        "zynd"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Public URL",
      "description": "Black-box probe of the public URL. No data = this project has no public URL of its own (worker, mcp, plugins).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(probe_success{project=\"$project\", env=\"$env\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
