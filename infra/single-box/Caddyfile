# Plain-HTTP IP access to persona (persona-web and persona-api on one origin).
# The web apps are built against the domains above, so this is only useful for
# poking at persona-api directly (http://<ip>:3000/api/...).
http://:3000 {
	import observability
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
