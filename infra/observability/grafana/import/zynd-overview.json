    {
      "type": "timeseries",
      "title": "Memory by project",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (project) (container_memory_working_set_bytes{env=\"$env\"})",
          "legendFormat": "{{project}}"
