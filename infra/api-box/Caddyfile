# Caddy auto-provisions a free HTTPS certificate for this domain (Let's Encrypt)
# and proxies to the API container. Requires the DNS A record api.zynd.ai -> this
# server's IP, and ports 80/443 open.
api.zynd.ai {
	# memory and cards-api serve Prometheus metrics at /metrics; keep them off the public
	# name (same rule as the shared snippet in infra/single-box/Caddyfile). Caddy sorts
	# this handle ahead of the others (`caddy adapt` shows it first), so it wins.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}
	# Remote MCP endpoint (streamable-HTTP) for Claude/Cursor/any MCP client.
	handle /chatgpt/mcp* {
		reverse_proxy chatgpt-plugin:8091
	}
	handle /claude/mcp* {
		reverse_proxy claude-plugin:8092
	}
	handle /mcp* {
		reverse_proxy mcp:8090
	}
	# S11 public Cards MCP (no auth) — same mcp container, separate FastMCP app.
	handle /cards-public-mcp* {
		reverse_proxy mcp:8090
	}
	# S09: old Cards MCP path stays as an alias of the authenticated ZYND MCP.
	handle /cards-mcp* {
		uri replace /cards-mcp /mcp
		reverse_proxy mcp:8090
	}
	# OAuth protected-resource metadata (RFC 9728) — served by FastMCP.
	# Each plugin's document is served by its plugin server, not the general MCP.
	handle /.well-known/oauth-protected-resource/chatgpt/mcp* {
		reverse_proxy chatgpt-plugin:8091
	}
	handle /.well-known/oauth-protected-resource/claude/mcp* {
		reverse_proxy claude-plugin:8092
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy mcp:8090
	}
	# Memory-layer service-to-service endpoint (called by zynd-cards).
	# MUST stay above /v1* — that prefix otherwise routes to cards.
	handle /v1/service* {
		reverse_proxy api:8000
	}
	# Zynd agent profile cards API (separate FastAPI service).
	handle /cards* {
		reverse_proxy cards:8000
	}
	handle /ask* {
		reverse_proxy cards:8000
	}
	handle /onboard* {
		reverse_proxy cards:8000
	}
	handle /v1* {
		reverse_proxy cards:8000
	}
	handle {
		reverse_proxy api:8000
	}
}