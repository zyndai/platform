{
  "manifest_version": 3,
  "name": "Zynd Companion",
  "version": "0.0.0",
  "description": "Update your Zynd card from the page you are on: what you are working on and what you are exploring.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Zynd Companion",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms"],
  "host_permissions": [],
  "content_scripts": [
    { "matches": [], "js": ["connect-bridge.js"], "run_at": "document_start", "all_frames": false }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Z" }, "description": "Open Zynd Companion" }
  },
  "incognito": "not_allowed"
}
