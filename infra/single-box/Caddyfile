# Host Caddy for the single-box deployment (install to /etc/caddy/Caddyfile).
# Caddy gets and renews the Let's Encrypt certificates itself, but only once
# each hostname's A record points at this box and ports 80/443 are open.
# After pointing DNS here, `sudo systemctl reload caddy` retries issuance
# immediately instead of waiting for Caddy's backoff.

{
	# Let's Encrypt only. Ubuntu's Caddy 2.6.2 tries ZeroSSL first, and ZeroSSL's
	# legacy EAB registration endpoint is gone (HTTP 422 caddy_legacy_user_removed),
	# which makes every issuance attempt error out. Setting acme_ca drops the
	# ZeroSSL issuer. Not needed on a current Caddy.
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	# Per-host request/latency/status metrics, scraped by Prometheus from the
	# admin endpoint (127.0.0.1:2019/metrics). See infra/observability.
	servers {
		metrics
	}
}

# Shared by every site below: JSON access log (rotated by Caddy, read by
# Alloy into Loki) and a 404 for /metrics so app metrics stay internal.
# Must be the first thing in each site so its handle wins.
(observability) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}
}

# persona-web. /api/* also goes to persona-api on this host, same rule as the
# live persona box: the OAuth callbacks and A2A URLs registered with providers
# and the registry are https://persona.zynd.ai/api/...
persona.zynd.ai {
	import observability
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

# persona-api on its own host (what persona-web's NEXT_PUBLIC_API_URL points at).
persona.api.zynd.ai {
	import observability
	reverse_proxy 127.0.0.1:8000
}

# cards-web
cards.zynd.ai {
	import observability
	reverse_proxy 127.0.0.1:3002
}

# cards-api on its own host (what cards-web's NEXT_PUBLIC_API_URL points at).
cards.api.zynd.ai {
	import observability
	reverse_proxy 127.0.0.1:8002
}

# memory API, plus the legacy paths clients already call on api.zynd.ai
# (same routing as infra/api-box/Caddyfile).
api.zynd.ai {
	import observability
	# OpenAI plugin domain verification (token from the plugin's MCP settings page).
	handle /.well-known/openai-apps-challenge {
		header Content-Type text/plain
		respond "WGpC9Ddr-em0sfap28kcsbsouWUhyIQhJbMzcvgwnE8" 200
	}
	# Remote MCP endpoint (streamable-HTTP) for Claude/Cursor/any MCP client.
	handle /chatgpt/mcp* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /claude/mcp* {
		reverse_proxy 127.0.0.1:8092
	}
	handle /mcp* {
		reverse_proxy 127.0.0.1:8090
	}
	# S11 public Cards MCP (no auth) — same mcp process, separate FastMCP app.
	handle /cards-public-mcp* {
		reverse_proxy 127.0.0.1:8090
	}
	# S09: old Cards MCP path stays as an alias of the authenticated ZYND MCP.
	handle /cards-mcp* {
		uri replace /cards-mcp /mcp
		reverse_proxy 127.0.0.1:8090
	}
	# OAuth protected-resource metadata (RFC 9728), served by FastMCP. Each plugin's
	# document is served by its plugin server, not the general MCP.
	handle /.well-known/oauth-protected-resource/chatgpt/mcp* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /.well-known/oauth-protected-resource/claude/mcp* {
		reverse_proxy 127.0.0.1:8092
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy 127.0.0.1:8090
	}
	# Memory-layer service-to-service endpoint (called by cards).
	# MUST stay above /v1*: that prefix otherwise routes to cards.
	handle /v1/service* {
		reverse_proxy 127.0.0.1:8001
	}
	# Legacy cards paths on the memory host.
	handle /cards* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /ask* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /onboard* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /v1* {
		reverse_proxy 127.0.0.1:8002
	}
	handle {
		reverse_proxy 127.0.0.1:8001
	}
}

# Grafana (infra/observability). Grafana does its own login; /metrics is hidden by the
# shared snippet. Loki stays on loopback and is reached through Grafana's Explore. Needs
# an A record -> this box.
monitor.zynd.ai {
	import observability
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy 127.0.0.1:3030
}

# Prometheus UI and query API. Prometheus has no login of its own, so Caddy asks for a
# username and password; the bcrypt hash is in /etc/caddy/metrics-basicauth.conf on the
# box (root:caddy 640, NOT in git; see docs/MONITORING.md, "Public URLs"). The lifecycle
# endpoints are switched on for apply.sh's local reload, so they are refused here:
# anyone with the password could otherwise stop Prometheus.
metrics.zynd.ai {
	import observability
	import /etc/caddy/metrics-basicauth.conf
	@lifecycle path /-/quit /-/reload
	respond @lifecycle 403
	reverse_proxy 127.0.0.1:9090
}

