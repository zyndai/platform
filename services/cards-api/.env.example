# ── Supabase / Postgres ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
# Default schema is cards; legacy xmfj deployments must explicitly use public.
SUPABASE_DB_SCHEMA=cards
FEATURE_S04_EVENTS=true

# Which Supabase projects' login tokens to trust (comma-separated project URLs).
# Empty = just SUPABASE_URL. During the xmfj -> aafo move: both projects.
TRUSTED_SUPABASE_URLS=
# aafo's token issuer, e.g. https://aafoguuvmaxymrtnfafn.supabase.co/auth/v1.
# Only tokens from this issuer have their user id stored as owner_user_id.
AAFO_ISSUER=
# true = POST/PATCH/PUT/DELETE return 503 and the X bot pauses (cutover window)
MAINTENANCE_READONLY=false

# S12 human intros: dedicated token must match Persona (not a Supabase key).
FEATURE_S12_INTROS=false
PERSONA_API_URL=http://localhost:8000
PERSONA_SITE_URL=http://localhost:3000
CARDS_INTRO_SERVICE_TOKEN=

# ── LLM (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_REFERER=https://zynd.ai
OPENROUTER_APP_NAME=zynd-cards

# ── Scraping ──
GITHUB_TOKEN=

# ── Site / indexing ──
SITE_BASE_URL=https://zynd.ai
API_BASE_URL=https://api.zynd.ai
FRONTEND_URL=http://localhost:3002
INDEXNOW_KEY=
BING_API_KEY=
BING_SITE_URL=https://zynd.ai

# ── QuickEnrich (optional; free people search for suggested-people outsiders) ──
QUICKENRICH_BASE_URL=
QUICKENRICH_API_KEY=
QUICKENRICH_AUTH_HEADER=Authorization

# ── Morning digest (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CRON_SECRET=

# Explicit notification tests use CRON_SECRET and S10_MAILER=smtp.
# POST /internal/owner-notifications/test?kind=weekly&email=your-address
# Omit email to send to ALL card owners, bypassing preferences/delivery limits.

# cards-web cache bust after a memory snapshot write. The URL is hardcoded
# in config.py (https://cards.zynd.ai/api/revalidate) — override WEB_REVALIDATE_URL
# only for local dev. SECRET: must match WEB_REVALIDATE_SECRET in cards-web.
WEB_REVALIDATE_SECRET=

# ── Notifications ──
# S03 "Not me" takedown review. Mattermost incoming-webhook URL (same webhook
# as the deploy-failure alert). Optional — the review queue fills either way.
MATTERMOST_WEBHOOK_URL=

# --- Cards networking (docs/plans/ZYND_MEMORY_QUALITY_PLAN.md, section 17) ---
# Saved searches, reports, blocks, match preferences, request limits, verification badges, the digest's
# network section. Needs packages/db migration 0025 applied first. Off by default.
FEATURE_NETWORK_CONTROLS=false
# Invite someone who has no claimed Card (creates an unclaimed Card from public LinkedIn data).
# Needs packages/db migration 0024 applied first. Off by default.
FEATURE_A2_INVITE_TO_CLAIM=false
# People outside Zynd come from Memory's POST /v1/service/outside-people (MEMORY_LAYER_URL +
# MEMORY_SERVICE_TOKEN). QUICKENRICH_* settings are no longer read here.
