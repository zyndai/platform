    {
      "type": "timeseries",
      "title": "Memory by project",
      "description": "Containers (cAdvisor, working set) and pm2 processes (RSS), stacked. Persona's pm2 processes and the memory/cards containers are different workloads, both shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (project, env) (container_memory_working_set_bytes{project!=\"\"})",
          "legendFormat": "{{project}} ({{env}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (project, env) (pm2_process_memory_bytes)",
          "legendFormat": "{{project}} ({{env}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": null,
          "max": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "fillOpacity": 60,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
