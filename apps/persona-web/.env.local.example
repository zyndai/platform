# persona-web local env. Copy to apps/persona-web/.env.local (gitignored).
# The anon key is a PUBLIC key by design (it ships in the browser bundle);
# RLS is what protects data. Never put the service-role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local backends (ports from the root package.json)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MEMORY_API_URL=http://localhost:8001

NEXT_PUBLIC_GA_ID=
