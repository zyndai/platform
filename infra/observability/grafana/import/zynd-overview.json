    {
      "type": "stat",
      "title": "Errors logged",
      "description": "Log records at level=error in the selected range, all projects in this env.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({source=~\"docker|pm2\", env=\"$env\", level=\"error\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
