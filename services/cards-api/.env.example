# ── Supabase / Postgres ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
# Default schema is cards; legacy xmfj deployments must explicitly use public.
SUPABASE_DB_SCHEMA=cards
FEATURE_S04_EVENTS=true

# Which Supabase projects' login tokens to trust (comma-separated project URLs).
# Empty = just SUPABASE_URL. During the xmfj -> aafo move: both projects.
TRUSTED_SUPABASE_URLS=
# aafo's token issuer, e.g. https://aafoguuvmaxymrtnfafn.supabase.co/auth/v1.
# Only tokens from this issuer have their user id stored as owner_user_id.
AAFO_ISSUER=
# true = POST/PATCH/PUT/DELETE return 503 and the X bot pauses (cutover window)
MAINTENANCE_READONLY=false

# S12 human intros: dedicated token must match Persona (not a Supabase key).
FEATURE_S12_INTROS=false
PERSONA_API_URL=http://localhost:8000
PERSONA_SITE_URL=http://localhost:3000
CARDS_INTRO_SERVICE_TOKEN=

# ── LLM (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_REFERER=https://zynd.ai
OPENROUTER_APP_NAME=zynd-cards

# AI visibility report (POST /cards/visibility/check). Off = 404. Uses OPENROUTER_API_KEY with a
# web-search model; ~$0.006 per uncached check on perplexity/sonar. Pair with cards-web
# NEXT_PUBLIC_FEATURE_AI_VISIBILITY.
FEATURE_AI_VISIBILITY=false
AI_VISIBILITY_MODEL=perplexity/sonar
AI_VISIBILITY_MODEL_LABEL=Perplexity Sonar
# Paid checks per UTC day across all visitors (per worker process); over it the endpoint 429s.
AI_VISIBILITY_DAILY_CAP=300

# ── Scraping ──
GITHUB_TOKEN=

# ── Site / indexing ──
SITE_BASE_URL=https://zynd.ai
API_BASE_URL=https://api.zynd.ai
FRONTEND_URL=http://localhost:3002
INDEXNOW_KEY=
BING_API_KEY=
BING_SITE_URL=https://zynd.ai

# ── QuickEnrich (optional; free people search for suggested-people outsiders) ──
QUICKENRICH_BASE_URL=
QUICKENRICH_API_KEY=
QUICKENRICH_AUTH_HEADER=Authorization

# ── Morning digest (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CRON_SECRET=
# The digest goes out at 07:00 in each owner's own timezone (needs packages/db cards migration
# 0029). Owners who haven't opened /home since that shipped get 07:00 in this IANA zone.
DIGEST_DEFAULT_TIMEZONE=Asia/Kolkata

# Email a card owner right after an AI agent (Claude, ChatGPT, ...) reads their claimed card.
# Needs S10_MAILER=smtp plus SMTP_HOST/SMTP_FROM; owners who turned the morning digest off
# (or used its unsubscribe link) get none. At most one per card per cooldown window.
FEATURE_AI_READ_ALERTS=false
AI_READ_ALERT_COOLDOWN_HOURS=24
# Shared secret cards-web (server-side agent-fetch log) and Memory (MCP reads) send as
# X-Zynd-Server-Event on POST /events. Set the same value in both. Only those batches can
# trigger an AI-read alert; empty = no alerts from POST /events. Generate: openssl rand -hex 32
EVENTS_SERVER_TOKEN=

# Explicit notification tests use CRON_SECRET and S10_MAILER=smtp.
# POST /internal/owner-notifications/test?kind=weekly&email=your-address
# Omit email to send to ALL card owners, bypassing preferences/delivery limits.

# cards-web cache bust after a memory snapshot write. The URL is hardcoded
# in config.py (https://cards.zynd.ai/api/revalidate) — override WEB_REVALIDATE_URL
# only for local dev. SECRET: must match WEB_REVALIDATE_SECRET in cards-web.
WEB_REVALIDATE_SECRET=

# ── Notifications ──
# S03 "Not me" takedown review. Mattermost incoming-webhook URL (same webhook
# as the deploy-failure alert). Optional — the review queue fills either way.
MATTERMOST_WEBHOOK_URL=

# --- Cards networking (docs/plans/ZYND_MEMORY_QUALITY_PLAN.md, section 17) ---
# Saved searches, reports, blocks, match preferences, request limits, verification badges, the digest's
# network section. Needs packages/db migration 0025 applied first. Off by default.
FEATURE_NETWORK_CONTROLS=false
# Invite someone who has no claimed Card (creates an unclaimed Card from public LinkedIn data).
# Needs packages/db migration 0024 applied first. Off by default.
FEATURE_A2_INVITE_TO_CLAIM=false
# Group memory (rolling summary + durable facts) and Card AI assistant replies
# on @mentions. Needs packages/db migration 0026 applied first. Off by default.
FEATURE_GROUP_MEMORY=false
FEATURE_GROUP_AGENT_REPLIES=false
GROUP_MEMORY_SUMMARY_EVERY=30
GROUP_MEMORY_RECENT_MESSAGES=50
GROUP_MEMORY_SEARCH_LIMIT=8
GROUP_AGENT_POLL_SECONDS=2
GROUP_AGENT_MAX_STEPS=4
# Reply budget. Keep GROUP_AGENT_MAX_REPLY_CHARS at 4000 until packages/db
# cards migration 0028 is applied, then set 8000.
GROUP_AGENT_MAX_TOKENS=1800
GROUP_AGENT_MAX_REPLY_CHARS=4000
GROUP_AGENT_LLM_TIMEOUT=120
# Stream the reply to the group while it is written (Supabase Realtime REST
# broadcast). Does nothing without SUPABASE_URL + SUPABASE_SERVICE_KEY.
FEATURE_GROUP_AGENT_STREAMING=true
# DEV ONLY. Broadcasts the context and tool calls behind each reply to every
# group member. Never enable in production.
FEATURE_AGENT_DEBUG_SOURCES=false
# Stale "Working on": dim the chips on the public card after 90 days without a change, offer the
# owner a one-click "Still working on this" confirm, and add a nudge line to the morning digest.
# Needs packages/db cards migration 0033 for the timestamp. Pair with cards-web
# NEXT_PUBLIC_FEATURE_STALE_SIGNALS. Off by default.
FEATURE_STALE_SIGNALS=false
# People outside Zynd come from Memory's POST /v1/service/outside-people (MEMORY_LAYER_URL +
# MEMORY_SERVICE_TOKEN). QUICKENRICH_* settings are no longer read here.
